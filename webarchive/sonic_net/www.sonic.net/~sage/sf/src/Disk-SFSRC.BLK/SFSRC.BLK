V= WATCH-FRACTAL                                                ( FRACT-OV   CONSTANTS  & VARIABLES                    8-05-85)                                                                  2 C= FY2    ( frame offset for y2)                              4 C= FX2    ( frame offset for x2)                              6 C= FY1    ( frame offset for y1)                              8 C= FX1    ( frame offset for x1)                             10 C= FYMID  ( frame offset for ymid)                           12 C= FXMID  ( frame offset for xmid)                           14 C= FSTD   ( frame offset for std)                                                                                            V= RT0 ( return addr holder)                                    V= RT1 ( return addr holder)                                    V= RTEMP ( return stack pointer holder)                         V= TY  ( temp variable for xshift, yshift)                                                                                                                                                      ( FRACT-OV   SETSCALE GENANCHORS                      11-19-84)                                                                 : SETSCALE ( dratio scale -- \ set )                              ( deviation change ratio and scale)                             STD ! RATIO 2! ;                                                                                                              : GENANCHORS ( -- All Aul Aur Alr \ )                             ( generate 4 anchor points)                                     4 0 DO STD @ DUP NEGATE SWAP RRND                                   LOOP ;                                                                                                                                                                                                                                                                                                                                                                                                                                                    ( FRACT-OV   [RRND]  C+LIMIT                           8-05-85)                                                                 ASSEMBLER                                                                                                                       CREATE [RRND] ( lo hi rtn -- n \ generate a random # in the )     ( range lo to hi)                                               SEED 0 MOV  31421 # 1 MOV  1 IMUL  6927 # 0 ADD  0 SEED MOV     2 POP  U POP  1 POP  2 PUSH   1 U SUB  U MUL  1 2 ADD           0 POP  2 PUSH 0 PUSH RET                                                                                                                                                                      CREATE C+LIMIT ( c c rtn -- c \ add 2 bytes, clipping to limits)  U POP  0 POP  1 POP  1 0 ADD                                     127 # 0 CMP 0> IF  127 # 0 MOV THEN                            -127 # 0 CMP 0< IF -127 # 0 MOV THEN 0 PUSH U PUSH RET                                                                        ( FRACT-OV   DISPLACEMNT                               8-14-85) ASSEMBLER                                                       CREATE DISPLACEMNT ( xrel yrel rtn -- n \ generate a fractal )    ( displacement given relative location w/ optional fixed)       ( seeds to make fractal stationary)                             U POP  0 POP  1 POP  U PUSH XYANCHOR 2 MOV  2 2 OR 0>           IF XO' 1 ADD YO' 0 ADD  0< IF 0 INC 0 NEG  1152 # 1 ADD ELSE       960 # 2 MOV  2 0 CMP  0< NOT IF 2 0 SUB 0 NEG 2 0 ADD           0 INC  1152 # 1 ADD  THEN THEN 0 SEED MOV  1 PUSH               1 # 0 MOV 0 PUSH 0 NEG 0 PUSH  [RRND] CALL                      1 POP   SEED POP  1 PUSH                                        1 # 0 MOV 0 PUSH 0 NEG 0 PUSH  [RRND] CALL                      0 POP  1 POP  GLOBALSEED 0 XOR  1 0 XOR 0 SEED MOV           THEN                                                            FSTD R) 0 MOV  0 1 MOV  1 NEG 1 PUSH 0 PUSH [RRND] CALL         0 POP  1 POP  0 PUSH 1 PUSH RET                               ( FRACT-OV   [SWRAP]                                   8-06-85) ASSEMBLER                                                       CREATE [SWRAP] ( x y rtn -- x'y' \ calc new array cell coords)    ( using spherical wrap)                                         2 POP  0 POP  1 POP  0 0 OR  0<  ( is y below array?)           IF 0 INC 0 NEG                                                     'ARRAY U MOV  U ) U MOV ( #cols)                                U SHR  U 1 ADD                                               ELSE 'ARRAY U MOV  2 3) U MOV  ( #rows)                            U 0 CMP  0< NOT ( above array?)                                 IF  U 0 SUB  0 NEG  U 0 ADD 0 INC                                   'ARRAY U MOV  U ) U MOV ( #cols)                                U SHR  U 1 ADD                                              THEN                                                         THEN                                                                                                                          ( FRACT-OV   [SWRAP] continued                         8-06-85) ASSEMBLER                                                         1 1 OR 0<      ( left of array?)                                IF 'ARRAY U MOV  U ) 1 ADD                                      ELSE 'ARRAY U MOV U ) U MOV  U 1 CMP 0< NOT ( rt of array?)        IF U 1 SUB THEN                                              THEN                                                            1 PUSH 0 PUSH 2 PUSH RET                                      exit                                                            CODE  SWRAP  [SWRAP] CALL NEXT                                  HERE 'ARRAY !  10 , 10 , ( 10 rows , 10 cols)                   : swrpt >display >lores dark white !color                         100 100 lplot  110 110 lplot                                    115 95 do 105 i 2dup lplot 100 - swap 100 - SWAP                swrap 100 + swap 100 + SWAP lplot key drop loop >alpha ;                                                                      ( FRACT-OV   [ACELLADDR]                               8-05-85)                                                                 ASSEMBLER                                                       CREATE [ACELLADDR] ( x y rtn -- \ compute array )                 ( cell address with optional spherical boundary wrapping)       RT0 POP ( x y -- )                                              SPHEREWRAP 0 MOV  0 0 OR 0>                                     IF [SWRAP] CALL THEN                   ( x'y'-- )               'ARRAY U MOV  6 3) 0 MOV  4 3) U MOV                            1 POP  1 SHL  1 U ADD  DS PUSHS                                 0 DS LSG  U ) 1 MOV  DS POPS  2 POP  2 1 ADD                    0 SCELL MOV  1 OCELL MOV RT0 PUSH  RET                                                                                        CODE NACELL [ACELLADDR] CALL NEXT ( TEST THIS)                                                                                                                                                  ( FRACT-OV   [A@]                                      8-06-85)                                                                 ASSEMBLER                                                       CREATE [A@] ( rtn -- c or n \ long byte fetch with )              ( optional sign extension for current array cell)               2 POP  OCELL U MOV  DS PUSHS  SCELL PUSH  DS POPS               U ) 0 MOV B  DS POPS  SIGNEXTEND 1 MOV  1 1 OR                  0> IF CBW ELSE 0 HI 0 HI XOR B THEN 0 PUSH 2 PUSH RET                                                                                                                                                                                                                                                                         